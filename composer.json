{
  "name": "debuss-a/piccolo",
  "type": "project",
  "description": "A PSR-15 application skeleton built on the Piccolo framework (Laminas Stratigility and Mezzio components), with a scoped container, attribute-based routing, FrankenPHP worker mode support, and a DDD-layered structure.",
  "license": "MIT",
  "keywords": [
    "psr",
    "psr-7",
    "psr-15",
    "mezzio",
    "laminas",
    "ddd",
    "micro",
    "framework",
    "api",
    "frankenphp"
  ],
  "authors": [
    {
      "name": "Alexandre Debusschère",
      "email": "alexandre.debusschere@hey.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Application\\": "src/Application/",
      "Domain\\": "src/Domain/",
      "Infrastructure\\": "src/Infrastructure/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../piccolo-framework",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../piccolo-container",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "debuss-a/piccolo-container": "^0.1@dev",
    "debuss-a/piccolo-framework": "^0.1@dev",
    "php-http/curl-client": "^2.4",
    "psr/http-client": "^1.0"
  },
  "require-dev": {
    "pestphp/pest": "^5.1"
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8080 -t ./public/ ./public/index.php"
    ],
    "test": [
      "./vendor/bin/pest"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false,
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
