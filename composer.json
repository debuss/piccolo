{
  "name": "debuss-a/piccolo",
  "type": "project",
  "description": "A PSR-15 application skeleton built on Laminas Stratigility and Mezzio components, with League Container, attribute-based routing, and a DDD-layered structure.",
  "license": "MIT",
  "keywords": [
    "psr",
    "psr-7",
    "psr-15",
    "mezzio",
    "laminas",
    "ddd",
    "micro",
    "framework",
    "api"
  ],
  "authors": [
    {
      "name": "Alexandre Debusschère",
      "email": "alexandre.debusschere@hey.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Application\\": "src/Application/",
      "Domain\\": "src/Domain/",
      "Infrastructure\\": "src/Infrastructure/"
    },
    "files": [
      "bootstrap/defines.php",
      "bootstrap/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "borschphp/config": "^1.4",
    "debuss-a/attribute-routing": "^2.0",
    "debuss-a/awareness": "^1.2",
    "debuss-a/server-request-factory": "^1.0",
    "laminas/laminas-diactoros": "^3.8",
    "laminas/laminas-httphandlerrunner": "^2.13",
    "laminas/laminas-stratigility": "^4.3",
    "league/container": "^5.2",
    "league/plates": "^3.6",
    "mezzio/mezzio-fastroute": "^3.14",
    "mezzio/mezzio-helpers": "^5.20",
    "mezzio/mezzio-platesrenderer": "^2.14",
    "mezzio/mezzio-problem-details": "^1.19",
    "mezzio/mezzio-router": "^4.2",
    "mezzio/mezzio-template": "^3.0",
    "monolog/monolog": "^3.10",
    "php-http/curl-client": "^2.4",
    "psr/container": "^2.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "pestphp/pest": "^5.1"
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8080 -t ./public/ ./public/index.php"
    ],
    "test": [
      "./vendor/bin/pest"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false,
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
