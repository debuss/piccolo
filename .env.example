APP_NAME=app
APP_VERSION=1.0.0
APP_URL=http://localhost:8080

# In production, you should set APP_ENV=production as a real server environment variable :
# (Apache `SetEnv`, nginx `fastcgi_param`, Docker `ENV`, systemd `Environment=...`).
APP_ENV=development

LOGGER_NAME=app
# Where logs are written: php://stderr (default), or a file path relative to the app root (e.g. storage/logs/app.log)
LOG_STREAM=php://stderr
# Minimum level to log (debug, info, notice, warning, error, ...), defaults to debug, or info in production
#LOG_LEVEL=debug

TIMEZONE=UTC

DB_DRIVER=Pdo_Sqlite
DB_DATABASE=database.sqlite
