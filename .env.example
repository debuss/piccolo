# In production, you should set APP_ENV=production as a real server environment variable :
# (Apache `SetEnv`, nginx `fastcgi_param`, Docker `ENV`, systemd `Environment=...`).
APP_ENV=development

LOGGER_NAME=app
# Where logs are written: php://stderr (default), or a file path relative to the app root (e.g. storage/logs/app.log)
LOG_STREAM=php://stderr
# Minimum level to log (debug, info, notice, warning, error, ...), defaults to debug, or info in production
#LOG_LEVEL=debug

TIMEZONE=UTC

# CORS, disabled when no origin is allowed (default). Allowed origins, separated by commas, with `*` wildcards
# (https://*.example.com), or `*` for any origin:
#CORS_ALLOWED_ORIGINS=http://localhost:5173
# Request headers allowed (default Content-Type), and response headers readable by the browser:
#CORS_ALLOWED_HEADERS=Content-Type,Authorization
#CORS_EXPOSED_HEADERS=ETag
# Whether cookies and Authorization headers are sent (default false, not allowed with CORS_ALLOWED_ORIGINS=*):
#CORS_ALLOW_CREDENTIALS=false
# How long, in seconds, the browser caches a preflight response (not cached by default):
#CORS_MAX_AGE=600
